PORT=3001
JWT_SECRET=change-moi-en-production-avec-une-vraie-cle-secrete

# Domaines autorisés à appeler l'API en production, séparés par des
# virgules (ex: https://app.rogwebservice.ci). Sans cette variable, CORS
# reste ouvert — pratique en dev, à définir impérativement en production.
ALLOWED_ORIGINS=

# --- Base de données ---
# Par défaut (aucune variable DB_TYPE) : SQLite local, pratique en dev.
DB_PATH=god_rogwebservice.sqlite

# Pour passer sur PostgreSQL (recommandé en production), définir :
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=god_rogwebservice
# DB_USER=rogweb
# DB_PASSWORD=un-mot-de-passe-fort
# DB_SSL=false

# --- IA (optionnel) ---
# Clé gratuite sur https://aistudio.google.com/apikey — sans elle, l'IA
# fonctionne en mode simulation (stub) pour le développement/test.
GEMINI_API_KEY=
