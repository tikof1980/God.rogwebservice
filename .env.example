# Copier ce fichier en .env à la racine du projet avant de lancer
# `docker compose up -d --build`

# --- Base de données PostgreSQL ---
POSTGRES_DB=god_rogwebservice
POSTGRES_USER=rogweb
POSTGRES_PASSWORD=change-moi-avec-un-mot-de-passe-fort

# --- Backend ---
JWT_SECRET=change-moi-avec-une-vraie-cle-secrete-aleatoire

# Optionnel — active l'IA (Gemini) si renseigné, sinon simulation automatique
GEMINI_API_KEY=

# --- Frontend ---
# URL publique par laquelle le navigateur du client atteint l'API backend
# (ex: https://api.votredomaine.com en production, pas "backend" ni "localhost")
PUBLIC_API_URL=http://localhost:3001
